---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroAnimated from '../components/react/HeroAnimated';

const HOME_DATA = {
  hero: {
    title: "Diseñando el",
    titleAccent: "mañana digital",
    subtitle: "Soluciones visuales inteligentes que impulsan la próxima generación de innovación tecnológica.",
    ctaPrimary: { text: "Conocer más", link: "/nosotros" },
    ctaSecondary: { text: "Ver proyectos", link: "/proyectos" },
    videoUrl: "https://assets.mixkit.co/videos/preview/mixkit-abstract-technology-lines-and-dots-in-blue-23265-large.mp4",
    centerTextLabel: "Tecnología visual de alto impacto",
    centerTextMain: "Transformamos espacios con pantallas LED de ",
    centerTextAccent: "máxima definición.",
  },
};

const GALLERY_IMGS = [
  "/Cato11.png",
  "/Cato10.png",
  "/Cato1.png",
  "/Cato2.png",
  "/Cato3.png",
  "/Cato5.png",
];
---

<BaseLayout 
  title="Inicio" 
  description="Visual Point - Soluciones visuales inteligentes que impulsan la innovación tecnológica. Pantallas LED de alto impacto para empresas en Perú."
>
  <!-- Hero Section -->
  <HeroAnimated
    client:load
    title={HOME_DATA.hero.title}
    titleAccent={HOME_DATA.hero.titleAccent}
    subtitle={HOME_DATA.hero.subtitle}
    videoUrl={HOME_DATA.hero.videoUrl}
    ctaPrimaryText={HOME_DATA.hero.ctaPrimary.text}
    ctaPrimaryLink={HOME_DATA.hero.ctaPrimary.link}
    ctaSecondaryText={HOME_DATA.hero.ctaSecondary.text}
    ctaSecondaryLink={HOME_DATA.hero.ctaSecondary.link}
    centerTextLabel={HOME_DATA.hero.centerTextLabel}
    centerTextMain={HOME_DATA.hero.centerTextMain}
    centerTextAccent={HOME_DATA.hero.centerTextAccent}
  />

  <!-- Mobile Gallery - Solo visible en móvil -->
  <section class="md:hidden py-12 px-4 bg-white">
    <p class="text-[10px] text-brand-celeste uppercase tracking-widest font-black mb-4 text-center font-accent">
      {HOME_DATA.hero.centerTextLabel}
    </p>
    <h2 class="text-xl font-display font-black text-brand-dark mb-6 tracking-tighter text-center px-2">
      {HOME_DATA.hero.centerTextMain}
      <span class="text-brand-celeste">{HOME_DATA.hero.centerTextAccent}</span>
    </h2>
    <div class="grid grid-cols-2 gap-3">
      {["/Imagen15.png", "/Imagen16.png", "/Imagen7.png", "/Imagen1.png"].map((src) => (
        <div class="aspect-square overflow-hidden rounded-xl shadow-lg">
          <img src={src} alt="" width="1920" height="1072" loading="lazy" decoding="async" class="w-full h-full object-cover" />
        </div>
      ))}
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider"></div>

  <!-- Brands Section -->
  <section class="brands-section py-10 md:py-16 bg-white w-full px-6 md:px-10 led-grid">
    <div class="w-full text-center max-w-7xl mx-auto">
      <p class="text-[10px] text-brand-celeste uppercase tracking-widest font-black mb-4 font-accent">
        Partnerships
      </p>
      <h2 class="text-4xl md:text-5xl font-display font-black text-brand-dark mb-8 md:mb-12 tracking-tighter">
        Marcas con las que <span class="text-gradient">trabajamos</span>
      </h2>

      <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12 md:gap-16">
        <!-- NovaStar -->
        <div class="p-4 sm:p-6">
          <img
            src="/NOVASTAR.png"
            alt="NovaStar"
            width="512"
            height="512"
            loading="lazy"
            decoding="async"
            class="h-32 sm:h-40 md:h-48 lg:h-56 w-auto object-contain"
          />
        </div>
        <!-- Nationstar -->
        <div class="p-4 sm:p-6">
          <img
            src="/Nationstar-logo.jpg"
            alt="Nationstar"
            width="725"
            height="242"
            loading="lazy"
            decoding="async"
            class="h-12 sm:h-14 md:h-16 w-auto object-contain"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider"></div>

  <!-- Featured Projects Gallery -->
  <section class="relative h-[80vh] bg-white overflow-hidden border-y border-gray-50">
    <div class="absolute inset-0 led-grid opacity-[0.03] z-0"></div>
    
    <!-- Image Slider (CSS-only for static) -->
    <div class="absolute inset-0" id="gallery-slider">
      {GALLERY_IMGS.map((img, i) => (
        <div 
          class="gallery-slide absolute inset-0 transition-all duration-1000 ease-in-out opacity-0"
          data-index={i}
        >
          <img
            src={img}
            alt=""
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover saturate-[0.85] brightness-[1.02]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-white/50 via-transparent to-white/20"></div>
        </div>
      ))}
    </div>

    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 md:translate-x-0 md:left-20 -translate-y-1/2 z-20 w-[90%] sm:w-auto text-center md:text-left">
      <h3 class="text-xl sm:text-2xl md:text-5xl lg:text-6xl font-display font-black text-brand-dark tracking-tighter leading-tight">
        Ingeniería de <br />
        <span class="text-gradient">visualización.</span>
      </h3>
    </div>

    <!-- Slide indicators -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-3 z-30" id="gallery-indicators">
      {GALLERY_IMGS.map((_, i) => (
        <button
          type="button"
          aria-label={`Mostrar proyecto ${i + 1}`}
          class="gallery-indicator w-2 h-2 rounded-full transition-all duration-500 bg-brand-dark/20 hover:bg-brand-dark/40"
          data-index={i}
        />
      ))}
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-[3px] bg-gray-50 z-30">
      <div id="gallery-progress" class="h-full bg-gradient-to-r from-brand-celeste to-brand-dark transition-all duration-500 w-0"></div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section py-24 md:py-32 bg-brand-dark relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand-celeste to-transparent"></div>
    </div>
    
    <div class="max-w-4xl mx-auto px-6 md:px-20 text-center relative z-10 cta-content">
      <span class="inline-block text-brand-celeste font-black text-[10px] tracking-widest uppercase mb-6">
        ¿Listo para destacar?
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-black text-white leading-tight tracking-tighter mb-8">
        Transforma tu espacio con tecnología LED de vanguardia
      </h2>
      <p class="text-lg text-white/70 mb-12 max-w-2xl mx-auto">
        Contáctanos hoy y recibe una asesoría personalizada sin costo para tu proyecto.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contacto"
          class="group flex items-center gap-3 px-8 py-4 bg-brand-celeste text-white text-sm font-bold uppercase tracking-wider rounded-full hover:bg-white hover:text-brand-dark transition-all duration-500 shadow-xl"
        >
          Solicitar Cotización
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  let cleanupGallerySlider = () => {};

  function initGallerySlider() {
    cleanupGallerySlider();

    const slides = document.querySelectorAll('.gallery-slide');
    const indicators = document.querySelectorAll('.gallery-indicator');
    const progress = document.getElementById('gallery-progress');
    let current = 0;
    const total = slides.length;

    if (total === 0) return;

    function showSlide(index: number) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0');
        slide.classList.add('opacity-100');
        (slide as HTMLElement).style.transform = 'scale(1)';
      } else {
        slide.classList.add('opacity-0');
        slide.classList.remove('opacity-100');
        (slide as HTMLElement).style.transform = 'scale(1.08)';
      }
    });

    indicators.forEach((ind, i) => {
      if (i === index) {
        ind.classList.remove('bg-brand-dark/20', 'w-2');
        ind.classList.add('bg-brand-celeste', 'w-8');
      } else {
        ind.classList.add('bg-brand-dark/20', 'w-2');
        ind.classList.remove('bg-brand-celeste', 'w-8');
      }
    });

    if (progress) {
      progress.style.width = `${((index + 1) / total) * 100}%`;
    }

    current = index;
  }

  // Initialize
  showSlide(0);

  // Auto-advance
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const intervalId = reduceMotion
    ? null
    : window.setInterval(() => {
        showSlide((current + 1) % total);
      }, 5000);

  // Click handlers
  const clickHandlers: Array<{ indicator: Element; handler: () => void }> = [];
  indicators.forEach((ind, i) => {
    const handler = () => showSlide(i);
    ind.addEventListener('click', handler);
    clickHandlers.push({ indicator: ind, handler });
  });

    cleanupGallerySlider = () => {
      if (intervalId) clearInterval(intervalId);
      clickHandlers.forEach(({ indicator, handler }) => {
        indicator.removeEventListener('click', handler);
      });
      cleanupGallerySlider = () => {};
    };
  }

  document.addEventListener('astro:page-load', initGallerySlider);
  document.addEventListener('astro:before-swap', () => cleanupGallerySlider());
  initGallerySlider();
</script>
