---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfiniteGallery from '../components/react/InfiniteGallery';
import DualInfiniteGallery from '../components/react/DualInfiniteGallery';

const PROJECTS = [
  {
    id: 1,
    title: "Universidad Católica Santa María",
    location: "Arequipa, Perú",
    category: "Educación Superior",
    specs: "Pantallas Modulares | Indoor & Outdoor",
    gallery: [
      { src: "/Cato1.png", alt: "Proyecto UCSM, vista 1" },
      { src: "/Cato2.png", alt: "Proyecto UCSM, vista 2" },
      { src: "/Cato3.png", alt: "Proyecto UCSM, vista 3" },
      { src: "/Cato4.png", alt: "Proyecto UCSM, vista 4" },
      { src: "/Cato5.png", alt: "Proyecto UCSM, vista 5" },
      { src: "/Cato6.png", alt: "Proyecto UCSM, vista 6" },
    ],
    gallery2: [
      { src: "/Cato7.png", alt: "Proyecto UCSM, vista 7" },
      { src: "/Cato8.png", alt: "Proyecto UCSM, vista 8" },
      { src: "/Cato9.png", alt: "Proyecto UCSM, vista 9" },
      { src: "/Cato10.png", alt: "Proyecto UCSM, vista 10" },
      { src: "/Cato11.png", alt: "Proyecto UCSM, vista 11" },
      { src: "/Cato12.jpg", alt: "Proyecto UCSM, vista 12" },
    ],
    description: `Implementación integral de soluciones de visualización LED de alta tecnología para la Universidad Católica Santa María, abarcando múltiples espacios estratégicos del campus universitario.

El proyecto contempló la instalación de pantallas modulares LED tanto en ambientes interiores como exteriores, optimizando la comunicación institucional y la experiencia educativa.

Los auditorios principales fueron equipados con videowalls de gran formato, diseñados para conferencias magistrales, eventos institucionales y transmisiones en vivo con calidad cinematográfica.`,
  },
  {
    id: 2,
    title: "Centro Médico ESSALUD",
    location: "Perú",
    category: "Sector Salud",
    specs: "Tótems y Pantallas Indoor",
    gallery: [
      { src: "/Essalud1.png", alt: "Proyecto ESSALUD, vista 1" },
      { src: "/Essalud2.png", alt: "Proyecto ESSALUD, vista 2" },
      { src: "/Essalud3.jpg", alt: "Proyecto ESSALUD, vista 3" },
      { src: "/Essalud4.jpg", alt: "Proyecto ESSALUD, vista 4" },
    ],
    description: `Desarrollo e implementación de un sistema integral de señalización digital mediante tótems informativos y pantallas LED indoor para las instalaciones del Centro Médico ESSALUD, orientado a mejorar la experiencia del paciente y optimizar la gestión de información hospitalaria.

La solución implementada permite la gestión centralizada de contenidos, incluyendo turnos de atención, información preventiva de salud y comunicados institucionales.`,
  },
];
---

<BaseLayout 
  title="Proyectos" 
  description="Descubre nuestros proyectos ejecutados: soluciones LED para universidades, centros médicos y corporaciones en Perú."
>
  <!-- Hero Section -->
  <section class="relative pt-28 pb-14 md:pt-36 md:pb-20 bg-white overflow-hidden">
    <div class="absolute inset-0 led-grid opacity-[0.02]"></div>
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand-celeste/5 to-transparent"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-20 text-center">
      <div class="flex items-center justify-center gap-4 reveal-up mb-8 fade-in-up" style="animation-delay: 0.1s;">
        <div class="h-px w-16 bg-brand-celeste/30"></div>
        <span class="text-brand-celeste font-black text-xs tracking-[0.2em] uppercase">
          Portafolio
        </span>
        <div class="h-px w-16 bg-brand-celeste/30"></div>
      </div>

      <h1 class="reveal-up text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-display font-black text-brand-dark leading-[0.95] tracking-tight mb-8 fade-in-up" style="animation-delay: 0.2s;">
        Proyectos
        <br />
        <span class="text-brand-celeste">ejecutados</span>
      </h1>

      <p class="reveal-up text-lg md:text-xl text-text-secondary max-w-4xl mx-auto leading-relaxed fade-in-up" style="animation-delay: 0.3s;">
        Descubra cómo hemos transformado espacios corporativos, educativos y de salud con soluciones de visualización LED de última generación.
      </p>
    </div>
  </section>

  <!-- Divider -->
  <div class="h-px bg-gradient-to-r from-transparent via-gray-200 to-transparent"></div>

  <!-- Projects List -->
  <section class="py-12 md:py-20 bg-gray-50/50">
    <div class="max-w-7xl mx-auto px-6 md:px-20">
      <div class="space-y-16 md:space-y-24">
        {PROJECTS.map((project, projectIdx) => (
          <article class="project-card">
            <!-- Project Number & Header -->
            <div class="flex items-start gap-4 sm:gap-6 mb-10 md:mb-12">
              <span class="text-6xl sm:text-8xl md:text-9xl font-display font-black text-gray-100 leading-none select-none shrink-0">
                {String(projectIdx + 1).padStart(2, '0')}
              </span>
              <div class="pt-2 sm:pt-4 flex-1 min-w-0">
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-10 h-10 rounded-xl bg-brand-celeste/10 flex items-center justify-center">
                    {project.category === "Educación Superior" && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-brand-celeste">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                      </svg>
                    )}
                    {project.category === "Sector Salud" && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-brand-celeste">
                        <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"></path>
                        <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"></path>
                        <circle cx="20" cy="10" r="2"></circle>
                      </svg>
                    )}
                  </div>
                  <span class="text-brand-celeste font-bold text-xs tracking-widest uppercase">
                    {project.category}
                  </span>
                </div>
                <h2 class="text-3xl md:text-5xl font-display font-black text-brand-dark leading-tight tracking-tight">
                  {project.title}
                </h2>
                <div class="flex flex-wrap items-center gap-x-2 gap-y-2 text-text-secondary text-sm mt-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  {project.location}
                  <span class="mx-2">•</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path>
                    <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path>
                    <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path>
                  </svg>
                  {project.specs}
                </div>
              </div>
            </div>

            <!-- Description -->
            <div class="w-full mb-12">
              {project.description.split('\n\n').map((p) => (
                <p class="text-text-secondary text-base md:text-lg leading-relaxed mb-4 last:mb-0">
                  {p}
                </p>
              ))}
            </div>

            <!-- Gallery -->
            {project.id === 1 ? (
              <DualInfiniteGallery 
                client:visible 
                row1Images={project.gallery} 
                row2Images={project.gallery2 || []} 
              />
            ) : (
              <InfiniteGallery client:visible images={project.gallery} direction="left" />
            )}

            <!-- Divider -->
            {projectIdx < PROJECTS.length - 1 && (
              <div class="mt-16 md:mt-24 h-px bg-gradient-to-r from-transparent via-gray-200 to-transparent"></div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-14 md:py-20 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-display font-black text-brand-dark mb-4 tracking-tight">
        ¿Tiene un proyecto en mente?
      </h2>
      <p class="text-text-secondary text-lg mb-8 max-w-xl mx-auto">
        Contáctenos para una consultoría personalizada sobre soluciones LED para su organización.
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center gap-3 bg-brand-dark text-white px-8 py-4 rounded-full font-bold hover:bg-brand-celeste transition-colors duration-300 group"
      >
        Solicitar información
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .fade-in-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }

  @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
</style>
