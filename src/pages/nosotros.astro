---
import BaseLayout from '../layouts/BaseLayout.astro';
import HexagonGrid from '../components/react/HexagonGrid';

const VALUES = [
  { icon: "Shield", title: "Confianza", desc: "Respaldo absoluto en cada instalación." },
  { icon: "Award", title: "Excelencia", desc: "Calidad inmejorable en hardware y software." },
  { icon: "Users", title: "Colaboración", desc: "Trabajamos codo a codo con tu visión." },
  { icon: "Target", title: "Precisión", desc: "Cuidado milimétrico en cada proyecto." },
];
---

<BaseLayout 
  title="Nosotros" 
  description="Conoce a Visual Point - Empresa especializada en venta, instalación y asesoría de pantallas LED de alto impacto en Perú."
>
  <!-- Hero Section -->
  <section class="relative pt-24 pb-24 md:pt-32 md:pb-32 px-6 md:px-20 text-left led-grid">
    <div class="absolute top-0 left-0 right-0 h-[50vh] bg-gradient-to-br from-brand-celeste/5 to-transparent -z-10"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-16 items-center">
      <div class="space-y-8">
        <div class="space-y-4">
          <span class="reveal-text inline-block text-brand-celeste font-black text-[10px] tracking-widest uppercase fade-in-up" style="animation-delay: 0.1s;">
            Visual Point
          </span>
          <h1 class="reveal-text text-4xl sm:text-6xl md:text-8xl font-display font-black text-brand-dark leading-[0.85] tracking-tighter fade-in-up" style="animation-delay: 0.2s;">
            ¿Quiénes <br />
            <span class="text-brand-celeste">somos?</span>
          </h1>
        </div>

        <p class="reveal-text text-xl md:text-2xl text-brand-dark font-medium leading-normal max-w-xl fade-in-up" style="animation-delay: 0.3s;">
          VisualPoint es una empresa especializada en la{" "}
          <span class="text-brand-celeste underline decoration-brand-celeste/30 underline-offset-8">
            venta, instalación y asesoría
          </span>{" "}
          de pantallas LED de alto impacto.
        </p>
      </div>

      <div class="reveal-text bg-white p-6 sm:p-10 md:p-14 rounded-[40px] border border-gray-100 shadow-sm relative fade-in-up" style="animation-delay: 0.4s;">
        <div class="absolute top-0 left-0 w-2 h-full bg-brand-celeste/20 rounded-l-[40px]"></div>
        <p class="text-lg md:text-xl text-text-secondary leading-relaxed italic font-light">
          "Con años de experiencia en el rubro, ofrecemos soluciones modernas, eficientes y personalizadas para negocios que desean aumentar su visibilidad y destacar frente a la competencia."
        </p>
        <div class="mt-8 flex items-center gap-4">
          <div class="w-8 h-px bg-brand-celeste"></div>
          <span class="text-[10px] uppercase font-bold tracking-widest text-brand-dark italic">
            Excelencia en cada pixel
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider"></div>

  <!-- Hexagon Grid - React Island -->
  <HexagonGrid client:visible />

  <!-- Tech Divider -->
  <div class="tech-divider"></div>

  <!-- Values Section -->
  <section class="py-32 px-6 md:px-20 bg-[#FCFCFC]">
    <div class="max-w-7xl mx-auto mb-20 text-left">
      <p class="text-brand-celeste font-bold text-[10px] tracking-widest uppercase mb-4">
        Filosofía VisualPoint
      </p>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-brand-dark">
        Nuestros Valores
      </h2>
      <div class="w-8 h-1 bg-brand-celeste mt-4"></div>
    </div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-6 md:gap-12 text-left">
      {VALUES.map((val) => (
        <div class="reveal-text group space-y-4 md:space-y-6">
          <div class="w-12 h-12 md:w-16 md:h-16 bg-brand-celeste md:bg-white border border-transparent md:border-gray-100 rounded-xl md:rounded-2xl flex items-center justify-center text-white md:text-brand-celeste md:group-hover:bg-brand-celeste md:group-hover:text-white transition-all duration-500 shadow-sm">
            {val.icon === "Shield" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-7 md:h-7">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            )}
            {val.icon === "Award" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-7 md:h-7">
                <circle cx="12" cy="8" r="6"></circle>
                <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path>
              </svg>
            )}
            {val.icon === "Users" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-7 md:h-7">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            )}
            {val.icon === "Target" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-7 md:h-7">
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2"></circle>
              </svg>
            )}
          </div>
          <div class="space-y-2 md:space-y-3">
            <h3 class="text-base md:text-xl font-bold text-brand-dark uppercase tracking-wide">
              {val.title}
            </h3>
            <p class="text-text-secondary leading-relaxed text-xs md:text-sm">
              {val.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .fade-in-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }

  @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
</style>
