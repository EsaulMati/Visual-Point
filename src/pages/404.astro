---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página solicitada no está disponible. Regresa al inicio de Visual Point."
>
  <section class="legal-page-header-offset pb-24 px-6 md:px-20 min-h-[75vh] flex items-center">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-brand-celeste font-black text-xs tracking-widest uppercase mb-4">Error 404</p>
      <h1 class="text-4xl sm:text-6xl font-display font-black text-brand-dark tracking-tighter mb-6">
        Página no encontrada
      </h1>
      <p class="text-lg text-text-secondary max-w-xl mx-auto mb-10">
        La dirección que buscas no existe o ya no está disponible.
      </p>
      <a
        href="/"
        class="inline-flex items-center justify-center px-8 py-4 bg-brand-dark text-white text-sm font-bold uppercase tracking-wider rounded-full hover:bg-brand-celeste transition-colors duration-300"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</BaseLayout>
