---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageTransition from '../components/PageTransition.astro';
import SmoothScroll from '../components/react/SmoothScroll';
import LoadingScreen from '../components/LoadingScreen';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Soluciones visuales inteligentes que impulsan la innovación tecnológica. Pantallas LED de alto impacto para empresas.",
  image = "/vp-logo.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Visual Point" />
  
  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`${title} | Visual Point`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:locale" content="es_PE" />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | Visual Point`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  
  <!-- Preconnect para fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Montserrat:wght@400;500;600;700;800;900&family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  
  <title>{title} | Visual Point</title>
  
  <!-- Astro View Transitions -->
  <ViewTransitions />
  
  <!-- Page Transition Styles are in global.css -->
</head>
<body class="min-h-screen flex flex-col overflow-x-hidden bg-brand-white text-text-primary font-sans antialiased">
  <script is:inline>
    /**
     * Gestión del flujo de navegación y carga (Optimización Astro)
     */
    (function() {
      const isInternalNav = sessionStorage.getItem('vp-navigating') === 'true';
      const path = window.location.pathname;

      // 1. Inyección de estado de carga inicial
      if (!isInternalNav) {
        document.documentElement.classList.add('is-loading');
      } else {
        document.documentElement.classList.remove('is-loading');
      }

      // 2. Lógica de flujo de la aplicación (Loader)
      function initAppFlow() {
        if (!isInternalNav) {
          const loader = getLoader();
          if (!loader) {
            document.documentElement.classList.remove('is-loading');
            return;
          }

          setTimeout(() => {
            loader.style.transition = 'opacity 0.8s ease-out';
            loader.style.opacity = '0';
            loader.style.pointerEvents = 'none';
            
            setTimeout(() => {
              loader.style.display = 'none';
              document.documentElement.classList.remove('is-loading');
            }, 800);
          }, 1800);
        } else {
          const loader = getLoader();
          if (loader) loader.style.display = 'none';
          document.documentElement.classList.remove('is-loading');
        }
      }

      const getLoader = () => document.getElementById('loading-screen-wrapper');
      const getOverlay = () => document.getElementById('page-transition-overlay');

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAppFlow);
      } else {
        initAppFlow();
      }

      // 3. Gestión de transiciones de página (Page Overlays)
      document.addEventListener('astro:before-preparation', () => {
        sessionStorage.setItem('vp-navigating', 'true');
        const overlay = getOverlay();
        if (overlay) {
          overlay.style.pointerEvents = 'all';
          overlay.style.transition = 'opacity 0.2s ease-out';
          overlay.style.opacity = '1';
        }
      });

      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.remove('is-loading'); 
        const loader = getLoader();
        if (loader) loader.style.display = 'none';

        const overlay = getOverlay();
        if (overlay) {
          setTimeout(() => {
            overlay.style.transition = 'opacity 0.5s ease-in-out';
            overlay.style.opacity = '0';
            overlay.style.pointerEvents = 'none';
            sessionStorage.removeItem('vp-navigating');
          }, 100);
        }
      });

      // 4. Utilidades generales y control de Scroll
      function initUtils() {
        const bar = document.getElementById('scroll-bar');
        if (bar) {
          const update = () => {
            const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            bar.style.width = scrolled + '%';
          };
          window.removeEventListener('scroll', window._vpScrollHandler);
          window._vpScrollHandler = update;
          window.addEventListener('scroll', update);
          update();
        }
        
        if (sessionStorage.getItem('vp-navigating') === 'true') {
          window.scrollTo(0, 0);
        }
      }

      document.addEventListener('astro:page-load', initUtils);
      initUtils();
    })();
  </script>
  
  <!-- Loading Screen (solo carga inicial / refresh) -->
  <div id="loading-screen-wrapper" transition:persist>
    <LoadingScreen client:load />
  </div>
  
  <!-- Page Transition Overlay (solo navegación entre páginas) -->
  <PageTransition transition:persist />
  
  <!-- Smooth Scroll Provider -->
  <SmoothScroll client:load />
  
  <!-- Scroll Progress Indicator -->
  <div id="scroll-progress" class="fixed top-0 left-0 w-full h-[3px] bg-transparent z-[10000]">
    <div id="scroll-bar" class="h-full bg-gradient-to-r from-brand-celeste to-brand-dark w-0 transition-all duration-100"></div>
  </div>
  
  <Header />
  
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  
  <Footer />
  
  <!-- WhatsApp Floating Button -->
  
  
  <style>
    /* Estilos para ocultar el contenido durante la carga inicial */
    html.is-loading #main-content,
    html.is-loading header,
    html.is-loading footer {
      opacity: 0;
      pointer-events: none;
    }
    
    #main-content, header, footer {
      transition: opacity 0.8s ease-in-out;
    }

    #loading-screen-wrapper {
      position: fixed;
      inset: 0;
      z-index: 99999;
    }
    
    .whatsapp-float {
      animation: pulse-shadow 2s infinite;
    }
    
    @keyframes pulse-shadow {
      0%, 100% { box-shadow: 0 4px 20px rgba(0, 40, 86, 0.3); }
      50% { box-shadow: 0 4px 30px rgba(0, 163, 221, 0.5); }
    }
  </style>
</body>
</html>
