---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageTransition from '../components/PageTransition.astro';
import SmoothScroll from '../components/react/SmoothScroll';
import LoadingScreen from '../components/LoadingScreen';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Soluciones visuales inteligentes que impulsan la innovación tecnológica. Pantallas LED de alto impacto para empresas.",
  image = "/vp-logo.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Visual Point',
  url: Astro.site?.toString(),
  logo: new URL('/vp-logo.png', Astro.site).toString(),
  email: 'comercial.visualpoint@gmail.com',
  areaServed: {
    '@type': 'Country',
    name: 'Perú',
  },
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Visual Point" />
  
  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`${title} | Visual Point`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:image:alt" content="Visual Point" />
  <meta property="og:site_name" content="Visual Point" />
  <meta property="og:locale" content="es_PE" />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | Visual Point`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />
  <meta name="twitter:image:alt" content="Visual Point" />

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  
  <!-- Preconnect para fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700;900&family=Poppins:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
  
  <title>{title} | Visual Point</title>
  
  <!-- Astro View Transitions -->
  <ClientRouter />
  
  <!-- Page Transition Styles are in global.css -->
</head>
<body class="min-h-screen flex flex-col overflow-x-hidden bg-brand-white text-text-primary font-sans antialiased">
  <a href="#main-content" class="skip-link">Saltar al contenido</a>
  <script is:inline>
    /**
     * Gestión del flujo de navegación y carga (Optimización Astro)
     */
    (function() {
      if (window._vpLayoutController) window._vpLayoutController.abort();
      const controller = new AbortController();
      const { signal } = controller;
      const timeoutIds = [];
      window._vpLayoutController = controller;

      const schedule = (callback, delay) => {
        const id = window.setTimeout(callback, delay);
        timeoutIds.push(id);
        return id;
      };
      signal.addEventListener('abort', () => {
        timeoutIds.forEach(id => clearTimeout(id));
        if (window._vpProgressCleanup) window._vpProgressCleanup();
      }, { once: true });

      const isInternalNav = sessionStorage.getItem('vp-navigating') === 'true';

      // 1. Inyección de estado de carga inicial
      if (!isInternalNav) {
        document.documentElement.classList.add('is-loading');
      } else {
        document.documentElement.classList.remove('is-loading');
      }

      // 2. Lógica de flujo de la aplicación (Loader)
      function initAppFlow() {
        if (!isInternalNav) {
          const loader = getLoader();
          if (!loader) {
            document.documentElement.classList.remove('is-loading');
            return;
          }

          schedule(() => {
            loader.style.transition = 'opacity 0.2s ease-out';
            loader.style.opacity = '0';
            loader.style.pointerEvents = 'none';
            
            schedule(() => {
              loader.style.display = 'none';
              document.documentElement.classList.remove('is-loading');
            }, 200);
          }, 100);
        } else {
          const loader = getLoader();
          if (loader) loader.style.display = 'none';
          document.documentElement.classList.remove('is-loading');
        }
      }

      const getLoader = () => document.getElementById('loading-screen-wrapper');
      const getOverlay = () => document.getElementById('page-transition-overlay');

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAppFlow, { signal });
      } else {
        initAppFlow();
      }

      // 3. Gestión de transiciones de página (Page Overlays)
      document.addEventListener('astro:before-preparation', () => {
        sessionStorage.setItem('vp-navigating', 'true');
        const overlay = getOverlay();
        if (overlay) {
          overlay.style.pointerEvents = 'all';
          overlay.style.transition = 'opacity 0.2s ease-out';
          overlay.style.opacity = '1';
        }
      }, { signal });

      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.remove('is-loading'); 
        const loader = getLoader();
        if (loader) loader.style.display = 'none';

        const overlay = getOverlay();
        if (overlay) {
          schedule(() => {
            overlay.style.transition = 'opacity 0.5s ease-in-out';
            overlay.style.opacity = '0';
            overlay.style.pointerEvents = 'none';
            sessionStorage.removeItem('vp-navigating');
          }, 100);
        }
      }, { signal });

      // 4. Utilidades generales y control de Scroll
      function initUtils() {
        if (window._vpProgressCleanup) window._vpProgressCleanup();
        const bar = document.getElementById('scroll-bar');
        if (bar) {
          const update = () => {
            const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            bar.style.width = scrolled + '%';
          };
          window.addEventListener('scroll', update, { passive: true });
          window._vpProgressCleanup = () => {
            window.removeEventListener('scroll', update);
          };
          update();
        }
        
        if (sessionStorage.getItem('vp-navigating') === 'true') {
          window.scrollTo(0, 0);
        }
      }

      document.addEventListener('astro:page-load', initUtils, { signal });
      initUtils();
    })();
  </script>
  
  <!-- Loading Screen (solo carga inicial / refresh) -->
  <div id="loading-screen-wrapper" transition:persist>
    <LoadingScreen client:load />
  </div>
  
  <!-- Page Transition Overlay (solo navegación entre páginas) -->
  <PageTransition transition:persist />
  
  <!-- Smooth Scroll Provider -->
  <SmoothScroll client:idle />
  
  <!-- Scroll Progress Indicator -->
  <div id="scroll-progress" class="fixed top-0 left-0 w-full h-[3px] bg-transparent z-[10000]">
    <div id="scroll-bar" class="h-full bg-gradient-to-r from-brand-celeste to-brand-dark w-0 transition-all duration-100"></div>
  </div>
  
  <Header />
  
  <main id="main-content" tabindex="-1" class="flex-1">
    <slot />
  </main>
  
  <Footer />
  
  <!-- WhatsApp Floating Button -->
  
  
  <style>
    /* Estilos para ocultar el contenido durante la carga inicial */
    html.is-loading #main-content,
    html.is-loading header,
    html.is-loading footer {
      opacity: 0;
      pointer-events: none;
    }
    
    #main-content, header, footer {
      transition: opacity 0.8s ease-in-out;
    }

    #loading-screen-wrapper {
      position: fixed;
      inset: 0;
      z-index: 99999;
    }
    
    .whatsapp-float {
      animation: pulse-shadow 2s infinite;
    }
    
    @keyframes pulse-shadow {
      0%, 100% { box-shadow: 0 4px 20px rgba(0, 40, 86, 0.3); }
      50% { box-shadow: 0 4px 30px rgba(0, 163, 221, 0.5); }
    }
  </style>
</body>
</html>
