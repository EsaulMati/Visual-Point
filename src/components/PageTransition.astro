---
// Componente de transición entre páginas
// Se activa solo cuando navegas entre páginas (no al refrescar)
---

<div id="page-transition-overlay" aria-hidden="true" class="page-transition-overlay" transition:persist>
  <!-- Animated geometric lines -->
  <div class="absolute inset-0 opacity-[0.08]">
    <div class="absolute top-[15%] left-0 w-full h-px bg-white"></div>
    <div class="absolute top-[30%] left-0 w-full h-px bg-white"></div>
    <div class="absolute top-[50%] left-0 w-full h-px bg-white"></div>
    <div class="absolute top-[70%] left-0 w-full h-px bg-white"></div>
    <div class="absolute top-[85%] left-0 w-full h-px bg-white"></div>
    <div class="absolute top-0 left-[20%] w-px h-full bg-white"></div>
    <div class="absolute top-0 left-[40%] w-px h-full bg-white"></div>
    <div class="absolute top-0 left-[60%] w-px h-full bg-white"></div>
    <div class="absolute top-0 left-[80%] w-px h-full bg-white"></div>
  </div>
  
  <!-- Glowing dot accents -->
  <div class="absolute top-[15%] left-[20%] w-2 h-2 rounded-full bg-brand-celeste opacity-30 blur-[2px]"></div>
  <div class="absolute top-[50%] left-[60%] w-3 h-3 rounded-full bg-white opacity-20 blur-[3px]"></div>
  <div class="absolute top-[70%] left-[40%] w-2 h-2 rounded-full bg-brand-celeste opacity-25 blur-[2px]"></div>
  
  <!-- Logo + label -->
  <div class="flex flex-col items-center gap-6 z-10">
    <img
      src="/vp-logo-icono.png"
      alt=""
      width="1280"
      height="714"
      class="transition-logo w-28 md:w-36 h-auto object-contain"
    />
    <span class="text-white/40 text-[9px] uppercase tracking-[0.4em] font-black">
      Visual Point
    </span>
  </div>
  
  <!-- Bottom gradient fade -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-brand-dark/60 to-transparent"></div>
</div>

<style>
  .page-transition-overlay {
    position: fixed;
    inset: 0;
    z-index: 99998;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    opacity: 0;
    background: linear-gradient(135deg, #00a3dd 0%, #005f8a 40%, #002856 100%);
  }

  .transition-logo {
    animation: transitionLogo 1.2s ease-in-out infinite alternate;
    filter: drop-shadow(0 0 30px rgba(0, 163, 221, 0.6));
  }

  @keyframes transitionLogo {
    0% { transform: scale(1) translateY(0); opacity: 0.8; }
    100% { transform: scale(1.05) translateY(-5px); opacity: 1; }
  }
</style>
