---
const currentYear = new Date().getFullYear();

const NAV_LINKS = [
  { name: "INICIO", href: "/" },
  { name: "NOSOTROS", href: "/nosotros" },
  { name: "PRODUCTOS", href: "/productos" },
  { name: "PROYECTOS", href: "/proyectos" },
  { name: "CONTACTO", href: "/contacto" },
];
---

<footer class="bg-white pt-20 pb-8 border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-6 md:px-20">
    <!-- Top section with curved divider -->
    <div class="flex justify-center -mt-28 mb-16">
      <div class="bg-white px-16 py-6 rounded-t-[40px] shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.1)]">
        <div class="w-20 h-1 bg-gradient-to-r from-brand-celeste to-brand-dark rounded-full mx-auto"></div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
      <!-- Logo & Description -->
      <div class="md:col-span-4 space-y-6">
        <img
          src="/vp-logo.png"
          alt="Visual Point"
          width="1280"
          height="714"
          class="h-20 w-auto"
        />
        <p class="text-text-secondary text-sm leading-relaxed max-w-xs">
          Líderes en ingeniería visual y soluciones de visualización digital de alto impacto en todo el Perú.
        </p>
      </div>

      <!-- Navigation Links -->
      <div class="md:col-span-4">
        <p class="text-brand-dark/60 font-bold text-xs uppercase tracking-[0.2em] mb-6">Navegación</p>
        <div class="grid grid-cols-2 gap-x-8 gap-y-4">
          {NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class="text-brand-dark font-bold text-sm hover:text-brand-celeste transition-colors tracking-wide"
            >
              {link.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Contact -->
      <div class="md:col-span-4">
        <p class="text-brand-dark/60 font-bold text-xs uppercase tracking-[0.2em] mb-6">Contacto Directo</p>
        <ul class="space-y-4">
          <li>
            <span class="block text-brand-celeste text-xs uppercase tracking-wider font-bold mb-1">Email</span>
            <a href="mailto:comercial.visualpoint@gmail.com" class="block max-w-full break-all text-brand-dark font-bold text-base sm:text-lg hover:text-brand-celeste transition-colors">
              comercial.visualpoint@gmail.com
            </a>
          </li>
          <li>
            <span class="block text-brand-celeste text-xs uppercase tracking-wider font-bold mb-1">Sedes</span>
            <span class="text-brand-dark font-bold text-lg">Arequipa, Trujillo y Lima</span>
          </li>
          <li>
            <span class="block text-brand-celeste text-xs uppercase tracking-wider font-bold mb-1">Cobertura</span>
            <span class="text-brand-dark font-bold text-lg">Atención en todo el Perú</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="h-px bg-gray-200 mb-8"></div>

    <!-- Copyright -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-brand-dark/40 text-xs uppercase tracking-widest font-bold">
        © {currentYear} Visual Point Engineering • All rights reserved
      </p>
      <div class="flex gap-8">
        <a href="/privacidad" class="text-brand-dark/40 hover:text-brand-dark text-xs uppercase tracking-wider font-bold transition-colors">
          Privacidad
        </a>
        <a href="/terminos" class="text-brand-dark/40 hover:text-brand-dark text-xs uppercase tracking-wider font-bold transition-colors">
          Términos
        </a>
      </div>
    </div>
  </div>
</footer>
